# Copy this file to .env on the VPS and replace every placeholder.
POSTGRES_DB=livrio
POSTGRES_USER=livrio
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
APP_PORT=8089

# Add your web frontend origin(s) if you use Flutter web.
# Native Flutter clients do not normally send a browser Origin header.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dispatch policy for courier assignment.
MAX_ACTIVE_ORDERS=3
LOCATION_FRESHNESS_SECONDS=60
MAX_PICKUP_RADIUS_KM=25